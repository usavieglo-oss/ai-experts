    document.getElementById("welcome").innerText=t.welcome;
    document.getElementById("heroText").innerText=t.hero;
    document.getElementById("discover").innerText=t.discover;
    document.getElementById("whatsappBtn").innerText=t.whatsapp;

    document.getElementById("servicesTitle").innerText=t.servicesTitle;
