    document.getElementById("service2Title").innerText=t.s2;
    document.getElementById("service2Text").innerText=t.s2t;

    document.getElementById("service3Title").innerText=t.s3;
    document.getElementById("service3Text").innerText=t.s3t;

    document.getElementById("service4Title").innerText=t.s4;
    document.getElementById("service4Text").innerText=t.s4t;

    document.getElementById("service5Title").innerText=t.s5;
    document.getElementById("service5Text").innerText=t.s5t;

    document.getElementById("service6Title").innerText=t.s6;
    document.getElementById("service6Text").innerText=t.s6t;

    document.getElementById("pointsTitle").innerText=t.pointsTitle;
    document.getElementById("pointsSub").innerText=t.pointsSub;
    document.getElementById("balanceText").innerText=t.balance;
    document.getElementById("pointButton").innerText=t.pointButton;
